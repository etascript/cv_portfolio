{
  "name": "@etascript/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:alt": "set VITE_DEV_API_TARGET=http://127.0.0.1:8005&& vite --host 127.0.0.1 --port 8004 --strictPort",
    "dev:legacy": "set VITE_DEV_API_TARGET=http://127.0.0.1:8001&& vite --host 127.0.0.1 --port 8000 --strictPort",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@etascript/shared": "file:../../packages/shared",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "pinia": "^2.2.4",
    "three": "^0.186.0",
    "vue": "^3.5.11",
    "vue-i18n": "^10.0.4",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@vue/tsconfig": "^0.5.1",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^2.1.6"
  }
}
